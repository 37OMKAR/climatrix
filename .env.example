# ==============================================================================
# CLIMATRIX / CLIMARIS ENVIRONMENT CONFIGURATION
# ==============================================================================
# All parameters below are OPTIONAL. The platform functions 100% out-of-the-box
# using free, public science datasets with automatic downscaled CMIP6 baseline
# fallbacks when rate limits or offline conditions are encountered.
#
# To unlock high-throughput batch evaluation, dedicated enterprise clusters,
# and high-resolution commercial basemaps, copy this file to `.env`:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Open-Meteo Commercial API Key (Recommended for high volume / portfolios)
# ------------------------------------------------------------------------------
# Default public endpoint has a limit of 10,000 calls/day and 5,000/hour per IP.
# Supplying this key switches all endpoints from public clusters to:
#   customer-archive-api.open-meteo.com
#   customer-climate-api.open-meteo.com
#   customer-flood-api.open-meteo.com
# Unlocks unlimited queries, 0 rate limit errors (HTTP 429), and guaranteed commercial SLAs.
# Get a key: https://open-meteo.com/en/pricing
VITE_OPEN_METEO_API_KEY=

# ------------------------------------------------------------------------------
# 2. Mapbox Access Token (Optional - High-Fidelity Vector & Satellite Tiles)
# ------------------------------------------------------------------------------
# Unlocks Mapbox Streets and Mapbox High-Resolution Satellite basemaps in the
# map layer dropdown, alongside Carto, Esri, and OpenStreetMap.
# Get a free token: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 3. Microsoft Planetary Computer Key (Optional - High Bandwidth Ocean Flooding)
# ------------------------------------------------------------------------------
# Increases API burst limits when requesting SAS tokens and Zarr chunk stores for
# Deltares 90m Global Coastal Inundation datasets.
# Get a free key: https://planetarycomputer.microsoft.com/
VITE_PLANETARY_COMPUTER_KEY=

# ------------------------------------------------------------------------------
# 4. Climate TRACE API Key (Optional - Asset-Level Emissions)
# ------------------------------------------------------------------------------
# Optional authorization key for querying emitting facilities (power plants,
# factories, steel, cement) within 50 km of evaluated sites.
# Reference: https://climatetrace.org/
VITE_CLIMATE_TRACE_KEY=
